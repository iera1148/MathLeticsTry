<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/rounded_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvQuestionNum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/sketch_orange"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/rounded_input"
        android:hint="@string/question_text"
        android:padding="8dp" />

    <EditText
        android:id="@+id/etOptionA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/rounded_input"
        android:hint="@string/option_a"
        android:padding="8dp" />

    <EditText
        android:id="@+id/etOptionB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/rounded_input"
        android:hint="@string/option_b"
        android:padding="8dp" />

    <EditText
        android:id="@+id/etOptionC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/rounded_input"
        android:hint="@string/option_c"
        android:padding="8dp" />

    <EditText
        android:id="@+id/etOptionD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/rounded_input"
        android:hint="@string/option_d"
        android:padding="8dp" />

    <EditText
        android:id="@+id/etCorrect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/rounded_input"
        android:hint="@string/correct_answer"
        android:maxLength="1"
        android:padding="8dp" />

</LinearLayout>
