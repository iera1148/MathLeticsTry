<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_quiz_title"
            android:textColor="@color/pencil_black"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etQuizTitle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_input"
            android:hint="@string/quiz_title_hint"
            android:paddingStart="12dp" />

        <EditText
            android:id="@+id/etQuizTopic"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_input"
            android:hint="@string/quiz_topic"
            android:paddingStart="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/grade_tier"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spGradeTier"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rounded_input"
            android:entries="@array/grade_tiers" />

        <Spinner
            android:id="@+id/spGradeLevel"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_input"
            android:entries="@array/grade_levels" />

        <TextView
            android:id="@+id/tvQuestionCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Questions: 0 / 20"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llQuestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnAddQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/sketch_blue"
            android:text="@string/add_question" />

        <Button
            android:id="@+id/btnSaveQuiz"
            style="@style/SketchButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="@string/save_quiz" />

    </LinearLayout>
</ScrollView>
